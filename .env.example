# Copy to .env locally. Generate a random secret of at least 32 characters.
# Never commit .env or deployment credentials.
APP_ENV=development
SECRET_KEY=
DATABASE_PATH=backend/data/antislop.sqlite3
FRONTEND_URL=http://localhost:4173
CORS_ORIGINS=http://localhost:4173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Production cross-site cookies need COOKIE_SECURE=true, COOKIE_SAMESITE=none.
# Prefer serving FastAPI and the frontend under the same site in production.
STAFF_EMAILS=

# OTP requests return 503 until SMTP_HOST and SMTP_FROM are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false

# Create a Google OAuth web client and register this exact callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Example production values (not deployed by this repository):
# FRONTEND_URL=https://antislop.bee3.in
# CORS_ORIGINS=https://antislop.bee3.in
# GOOGLE_REDIRECT_URI=https://your-api.example/api/auth/google/callback
